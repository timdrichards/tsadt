// Option: a value that may be absent. `deriving` adds Option.equals,
// Option.compare and Option.show.
export data Option<T> = None | Some(value: T) deriving (Eq, Ord, Show);

export function getOrElse<T>(o: Option<T>, fallback: T): T {
  return match (o) {
    Some(v) => v,
    None => fallback,
  };
}

export function showOption<T>(o: Option<T>): string {
  return match (o) {
    Some(v) => `Some(${v})`,
    None => "None",
  };
}
